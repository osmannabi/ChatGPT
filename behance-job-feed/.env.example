# Notion internal integration token (Settings > Connections > Develop integrations).
# Share the "Behance Job Feed" database with the integration.
NOTION_TOKEN=
# Data source id of the Behance Job Feed database
NOTION_DATA_SOURCE_ID=02957887-44d1-4eb9-993b-1112ab0a0264
# Only jobs scoring at or above this are pushed to Notion
MIN_SCORE=45
# How many detail pages to open per run (keeps it polite)
MAX_JOBS=40
# Only jobs showing "Ends in N days" with N at or above this (14 = posted today)
ENDS_IN_DAYS=14
